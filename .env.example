# The WebCam - AI-Powered Intelligent Security Surveillance System Environment Configuration

# Application
APP_NAME="The WebCam"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./backend/data/surveillance.db

# Storage Directories
STORAGE_DIR=./backend/data
EVIDENCE_DIR=./backend/data/evidence
ENROLLED_FACES_DIR=./backend/data/enrolled_faces
MODELS_DIR=./backend/data/models

# Video & AI Pipeline Settings
DEFAULT_CAMERA_SOURCE=0
DEFAULT_CONFIDENCE_THRESHOLD=0.45
FACE_MATCH_THRESHOLD=0.60
TRACKER_MAX_AGE_FRAMES=30
TRACKER_IOU_THRESHOLD=0.3
ENABLE_DEMO_FALLBACK=true

# Alert & Notification Settings
ALERT_COOLDOWN_SECONDS=15
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=
