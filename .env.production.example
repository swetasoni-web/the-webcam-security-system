# The WebCam — Production Environment Variables
# Copy this file to .env and fill in real values before deploying

# ─── Application ────────────────────────────────────────────────────
APP_NAME="The WebCam"
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# ─── Security (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))") ─
SECRET_KEY=REPLACE_WITH_32_BYTE_RANDOM_HEX_STRING

# ─── Default Login Passwords (change before going live!) ────────────
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
DEFAULT_OPERATOR_PASSWORD=CHANGE_ME_strong_operator_password
DEFAULT_VIEWER_PASSWORD=CHANGE_ME_strong_viewer_password

# ─── CORS (comma-separated list of your deployed frontend origin) ────
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ─── Database ────────────────────────────────────────────────────────
# SQLite (default, fine for single-server)
DATABASE_URL=sqlite:///./backend/data/surveillance.db

# ─── Storage ─────────────────────────────────────────────────────────
STORAGE_DIR=./backend/data
EVIDENCE_DIR=./backend/data/evidence
ENROLLED_FACES_DIR=./backend/data/enrolled_faces
MODELS_DIR=./backend/data/models

# ─── AI Pipeline ─────────────────────────────────────────────────────
DEFAULT_CONFIDENCE_THRESHOLD=0.45
FACE_MATCH_THRESHOLD=0.60
TRACKER_MAX_AGE_FRAMES=30
ENABLE_DEMO_FALLBACK=true

# ─── Email Alerts (optional) ─────────────────────────────────────────
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_RECIPIENT=security@yourdomain.com

